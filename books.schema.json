{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "catalogId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 1000000
    },
    "authors": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 1000000
          },
          "role": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "role"
        ]
      }
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "isbn10": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "isbn13": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "asin": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "goodreads": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "storygraph": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "hardcover": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "pagebound": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "fable": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "isbn10",
        "isbn13",
        "asin",
        "goodreads",
        "storygraph",
        "hardcover",
        "pagebound",
        "fable"
      ]
    },
    "format": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000000
        },
        {
          "type": "null"
        }
      ]
    },
    "language": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000000
        },
        {
          "type": "null"
        }
      ]
    },
    "pageCount": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "durationSeconds": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "medium": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audio": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "digital": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "audio",
        "digital"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "catalog": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "format": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "publisher": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "publishedYear": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "pageCount": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "audioDuration": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "catalog",
        "format",
        "publisher",
        "publishedYear",
        "pageCount",
        "audioDuration"
      ]
    },
    "publisher": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000000
        },
        {
          "type": "null"
        }
      ]
    },
    "publishedYear": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "originalPublicationYear": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "series": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 1000000
            },
            "position": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^-?\\d+(?:\\.\\d+)?$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "name",
            "position"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "catalogId",
    "title",
    "authors",
    "identifiers",
    "format",
    "language",
    "pageCount",
    "durationSeconds",
    "medium",
    "provenance",
    "publisher",
    "publishedYear",
    "originalPublicationYear",
    "series"
  ]
}
