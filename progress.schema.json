{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "entryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "attemptId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "recordedAt": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "string",
              "format": "date"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "syncAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "string",
          "format": "date"
        }
      ]
    },
    "source": {
      "type": "string",
      "maxLength": 1000000
    },
    "pagePosition": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "measuredPageCount": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "audioPositionSeconds": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "playbackSpeed": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "entryId",
    "attemptId",
    "percent",
    "recordedAt",
    "syncAt",
    "source",
    "pagePosition",
    "measuredPageCount",
    "audioPositionSeconds",
    "playbackSpeed"
  ]
}
